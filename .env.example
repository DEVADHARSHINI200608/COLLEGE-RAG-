# ============================================================
# Secure & Intelligent Agentic RAG Platform — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# ─── Application ────────────────────────────────────────────
APP_NAME="Agentic RAG Platform"
APP_ENV=development          # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
SECRET_KEY=your-super-secret-key-change-this-in-production-minimum-32-chars

# ─── Database ───────────────────────────────────────────────
# PostgreSQL (recommended for production)
DATABASE_URL=postgresql+asyncpg://raguser:ragpassword@localhost:5432/ragplatform
# SQLite (development only)
# DATABASE_URL=sqlite+aiosqlite:///./rag_platform.db

# ─── Vector Database ────────────────────────────────────────
VECTOR_DB_TYPE=chroma          # chroma | weaviate | pinecone
CHROMA_PERSIST_DIR=./chroma_db
# Weaviate (if using)
# WEAVIATE_URL=http://localhost:8080
# WEAVIATE_API_KEY=

# ─── File Storage ───────────────────────────────────────────
STORAGE_BACKEND=local          # local | s3
FILE_UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
# S3 (if using)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# S3_BUCKET_NAME=

# ─── JWT ────────────────────────────────────────────────────
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── External LLM (Primary) ─────────────────────────────────
# Set ONLY ONE primary provider
EXTERNAL_LLM_PROVIDER=openai   # openai | gemini | anthropic | azure_openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-haiku-20240307
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=

# ─── Embedding Model ────────────────────────────────────────
EMBEDDING_PROVIDER=openai      # openai | sentence_transformers | local
EMBEDDING_MODEL=text-embedding-3-small
# For local embeddings (no external API needed):
# EMBEDDING_PROVIDER=sentence_transformers
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# ─── Local LLM (Fallback) ───────────────────────────────────
LOCAL_LLM_PROVIDER=ollama      # ollama | llamacpp
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
LOCAL_LLM_ENABLED=true

# ─── API Usage Limits ───────────────────────────────────────
DAILY_TOKEN_LIMIT=100000
MONTHLY_TOKEN_LIMIT=2000000
DAILY_COST_LIMIT_USD=5.0
MONTHLY_COST_LIMIT_USD=50.0
# Per-role multipliers (1.0 = 100% of base limit)
STUDENT_LIMIT_MULTIPLIER=0.3
FACULTY_LIMIT_MULTIPLIER=0.6
ADMIN_LIMIT_MULTIPLIER=1.0
# Fallback threshold (switch to local when usage >= this %)
FALLBACK_THRESHOLD_PERCENT=90

# ─── Caching ────────────────────────────────────────────────
CACHE_BACKEND=memory           # memory | redis
CACHE_TTL_SECONDS=300
# REDIS_URL=redis://localhost:6379/0

# ─── Web Search ─────────────────────────────────────────────
WEB_SEARCH_PROVIDER=duckduckgo # duckduckgo | tavily | serpapi
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5
# TAVILY_API_KEY=
# SERPAPI_API_KEY=

# ─── Google Sheets ──────────────────────────────────────────
GOOGLE_SHEETS_ENABLED=false
# Path to Google service account JSON file
# GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/google_service_account.json
# Or use environment variable (JSON string, base64 encoded)
# GOOGLE_SERVICE_ACCOUNT_JSON_B64=

# ─── CORS ───────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# ─── Scheduler ──────────────────────────────────────────────
SCHEDULER_ENABLED=true
DEADLINE_CHECK_INTERVAL_MINUTES=30
AUTO_RECOVER_EXTERNAL_LLM=true
RECOVERY_CHECK_INTERVAL_MINUTES=10

# ─── Security ───────────────────────────────────────────────
BCRYPT_ROUNDS=12
RATE_LIMIT_REQUESTS_PER_MINUTE=60
MAX_UPLOAD_FILES_PER_REQUEST=10
ENABLE_AUDIT_LOGGING=true

# ─── Frontend ───────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="College RAG Platform"
